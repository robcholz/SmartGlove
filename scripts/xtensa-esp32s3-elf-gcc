#!/bin/sh
set -eu

tool_dir="$HOME/.rustup/toolchains/esp/xtensa-esp-elf"

if [ ! -d "$tool_dir" ]; then
  echo "esp Xtensa toolchain directory not found: $tool_dir" >&2
  echo "Install it with 'espup install' first." >&2
  exit 1
fi

tool_path=$(
  find "$tool_dir" -type f -path "*/xtensa-esp-elf/bin/xtensa-esp32s3-elf-gcc" | sort | tail -n 1
)

if [ -z "${tool_path:-}" ]; then
  echo "xtensa-esp32s3-elf-gcc not found under $tool_dir" >&2
  echo "Re-run 'espup install' to provision the ESP32-S3 linker." >&2
  exit 1
fi

exec "$tool_path" "$@"
